[Unit]
Description=GitHub Actions Runner Scale Set Process Manager
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/ghalet/config.yaml

[Service]
Type=simple
User=ghalet
Group=ghalet
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/ghalet run --config /etc/ghalet/config.yaml
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=infinity
UMask=0077

[Install]
WantedBy=multi-user.target
