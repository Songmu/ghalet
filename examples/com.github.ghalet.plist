<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.github.ghalet</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/ghalet</string>
    <string>run</string>
    <string>--config</string>
    <string>/Users/REPLACE_ME/.config/ghalet/config.yaml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>ExitTimeOut</key>
  <integer>900</integer>
  <key>AbandonProcessGroup</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/ghalet.jsonl</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/ghalet.stderr.log</string>
</dict>
</plist>
