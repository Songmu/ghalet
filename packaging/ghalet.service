[Unit]
Description=GitHub Actions Runner Scale Set Process Manager
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/ghalet/config.yaml

[Service]
Type=notify
NotifyAccess=main
User=root
Group=root
Environment=PATH=/usr/local/bin:/usr/bin:/bin
StateDirectory=ghalet
StateDirectoryMode=0755
CacheDirectory=ghalet
CacheDirectoryMode=0700
ExecStart=/usr/bin/ghalet run --config /etc/ghalet/config.yaml
ExecReload=/usr/bin/ghalet apply --config /etc/ghalet/config.yaml
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=15min
UMask=0077

[Install]
WantedBy=multi-user.target
